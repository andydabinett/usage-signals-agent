# Required for `signals refresh` (SEC EDGAR fair-access policy needs a contact email in the User-Agent)
CONTACT_EMAIL=you@example.com
# SEC fair-access policy format for *.sec.gov requests: "Name email"
SEC_USER_AGENT=Your Name you@example.com
# Only needed for `signals handoff --refresh`
OPENROUTER_API_KEY=
# Optional override (default anthropic/claude-sonnet-5.5)
HANDOFF_MODEL=
# Optional: Snowflake adapter stub
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
